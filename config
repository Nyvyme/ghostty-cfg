background = 181818
# foreground = d6cf9a

shell-integration-features = no-cursor
# cursor-color = d6cf9a
cursor-style = block
cursor-style-blink = false
# cursor-text = 2e2f30
cursor-click-to-move = true

mouse-hide-while-typing = true

background-opacity = 0.5

window-decoration = false
window-theme = dark
window-save-state = never
window-padding-x = 3
window-padding-y = 3
window-padding-balance = true

gtk-single-instance = false
gtk-titlebar = false

keybind = shift+ctrl+r=reload_config

keybind = shift+ctrl+h=new_split:left
keybind = shift+ctrl+j=new_split:down
keybind = shift+ctrl+k=new_split:up
keybind = shift+ctrl+l=new_split:right

keybind = alt+ctrl+h=goto_split:left
keybind = alt+ctrl+l=goto_split:right

custom-shader = "cursor_shader.glsl"
custom-shader-animation = true

clipboard-read = allow
clipboard-write = allow
